# Copy to .env and adjust. Used by docker-compose variable substitution.

# --- Postgres ---
POSTGRES_USER=mindlet
POSTGRES_PASSWORD=mindlet
POSTGRES_DB=mindlet
DATABASE_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB=mindlet

# --- AI service (optional) ---
OPENAI_API_KEY=
