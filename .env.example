# Copy to .env and adjust. Used by docker-compose variable substitution.

# --- Postgres ---
POSTGRES_USER=mindlet
POSTGRES_PASSWORD=mindlet
POSTGRES_DB=mindlet
# Used by apps/*/compose.yaml variable substitution (defaults exist per service)
DATABASE_USERNAME=mindlet
DATABASE_PASSWORD=mindlet
DATABASE_NAME=mindlet
# Per-service host ports when running all stacks together (see apps/<service>/.env.example).
# auth=5433, user=5434, course=5435, team=5436, lesson=5437, deck=5438, test=5439
DATABASE_PORT=5433

# --- Redis ---
REDIS_PORT=6379

# --- MongoDB ---
MONGO_PORT=27017
MONGO_DB=mindlet

# --- AI service (optional) ---
OPENAI_API_KEY=

# --- Storage (MinIO) ---
STORAGE_ROOT_USER=minioadmin
STORAGE_ROOT_PASSWORD=minioadmin
